{
	"schemaVersion": 1,
	"id": "carpettngaddtion",
	"version": "${version}",
	"name": "CarpetTNGAddtion",
	"description": "Carpet addon for Minecraft 1.21.4,add features about dispenser planting, trial cooldown, ominous potion. All rules default off, /carpet toggles.",
	"authors": [
		"namelessgod2008"
	],
	"contact": {
		"homepage": "https://github.com/namelessgod2008/CarpetTNGAddtion",
		"sources": "https://github.com/namelessgod2008/CarpetTNGAddtion"
	},
	"license": "MIT",
	"icon": "assets/carpettngaddtion/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.namelessgod2008.CarpetTNGAddtion"
		],
		"modmenu": [
			"com.namelessgod2008.modmenu.ModMenuIntegration"
		],
		"fabric-datagen": [
			"com.namelessgod2008.CarpetTNGAddtionDataGenerator"
		]
	},
	"mixins": [
		"carpettngaddtion.dispenser.mixins.json",
		"carpettngaddtion.apple.mixins.json",
		"carpettngaddtion.amethyst.mixins.json",
		"carpettngaddtion.suspicious.mixins.json",
		"carpettngaddtion.trialspawner.mixins.json",
		"carpettngaddtion.potion.mixins.json",
		"carpettngaddtion.obsidian.mixins.json",
		"carpettngaddtion.basalt.mixins.json",
		"carpettngaddtion.piglin.mixins.json",
		"carpettngaddtion.enderdragon.mixins.json",
		"carpettngaddtion.anvil.mixins.json",
		"carpettngaddtion.blazestick.mixins.json",
		"carpettngaddtion.spawner.mixins.json",
		"carpettngaddtion.silktouch.mixins.json",
		"carpettngaddtion.copper.mixins.json",
		"carpettngaddtion.creeper.mixins.json",
		"carpettngaddtion.farmland.mixins.json",
		"carpettngaddtion.villager.mixins.json",
		"carpettngaddtion.endcrystal.mixins.json",
		"carpettngaddtion.snowgolem.mixins.json",
		"carpettngaddtion.enchantment.mixins.json",
		"carpettngaddtion.vex.mixins.json",
		"carpettngaddtion.tadpole.mixins.json",
		"carpettngaddtion.slime.mixins.json",
		"carpettngaddtion.compact.mixins.json"
